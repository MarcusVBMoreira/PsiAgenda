# Banco de dados (MySQL via XAMPP em desenvolvimento)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=psiagenda

# Autenticacao
JWT_SECRET=troque-este-valor-por-um-segredo-forte
JWT_EXPIRES_IN=7d

# SMTP (2FA e recuperacao de senha) — usar um e-mail existente, sem servicos pagos externos
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seuemail@exemplo.com
SMTP_PASSWORD=
SMTP_FROM="PsiAgenda <seuemail@exemplo.com>"

# WhatsApp (lembretes e confirmacoes) via Meta Cloud API (oficial do WhatsApp
# Business). Exige: app criado em developers.facebook.com, produto WhatsApp
# adicionado, numero de telefone comercial verificado, token permanente de um
# System User, e 2 modelos de mensagem (template) aprovados no WhatsApp
# Manager — um para confirmacao, um para lembrete — cada um com exatamente 4
# variaveis no corpo, nesta ordem: nome do paciente, nome do profissional,
# data, horario. Ver README.md > "Configurar o WhatsApp (Meta Cloud API)".
# Deixe tudo em branco para manter so o log (sem enviar de verdade).
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_TEMPLATE_CONFIRMATION=
WHATSAPP_BUSINESS_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_LANG=pt_BR
WHATSAPP_API_VERSION=v21.0

# URL base da aplicacao (usada em links de e-mail)
APP_URL=http://localhost:3000

# Segredo usado para autenticar chamadas aos endpoints de cron (lembretes,
# aderencia, guarda documental). No hPanel, configure o Cron Job para chamar
# a URL com ?token=<este-valor> (ex.: curl "https://seudominio/api/cron/reminders?token=...").
CRON_SECRET=troque-por-um-segredo-forte
