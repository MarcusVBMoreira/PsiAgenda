# Banco de dados MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=psiagenda

# SMTP (2FA, recuperacao de senha, confirmacao/lembrete de sessao)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PsiAgenda <seuemail@exemplo.com>"

# URL base da aplicacao, sem barra no final (usada em redirects e links)
APP_URL=http://localhost/PsiAgenda

# Segredo usado para autenticar chamadas aos endpoints de cron (lembretes,
# aderencia, guarda documental). Configure o Cron Job com ?token=<este-valor>.
CRON_SECRET=troque-por-um-segredo-forte

# WhatsApp (Meta Cloud API) — preenchido na Fase 5 da migracao.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_TEMPLATE_CONFIRMATION=
WHATSAPP_BUSINESS_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_LANG=pt_BR
WHATSAPP_API_VERSION=v21.0
